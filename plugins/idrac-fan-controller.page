Menu="Dashboard:0"
---
<?php
$pluginname   = "iDRAC Fans";
$status_file  = '/mnt/user/appdata/idrac-fan-controller/status.json';
$override_file= '/mnt/user/appdata/idrac-fan-controller/fan_override';
$pid_file     = '/var/run/idrac-fan-controller.pid';

$status = [];
if (file_exists($status_file)) {
  $status = json_decode(file_get_contents($status_file), true) ?? [];
}

$fan_pct    = $status['fan_speed_pct'] ?? null;
$fan_rpm    = $status['avg_fan_rpm']   ?? 0;
$cpu_temp   = $status['cpu1_temp']     ?? '--';
$profile    = $status['fan_profile']   ?? 'No data';
$timestamp  = $status['timestamp']     ?? '--';
$override   = $status['override_active'] ?? false;

$fan_display = ($fan_pct === null) ? '--' : (($fan_pct == 100) ? 'Dell Auto' : $fan_pct . '%');
$rpm_display = ($fan_rpm > 0) ? number_format($fan_rpm) : '--';

$short_profile = $profile;
if (preg_match('/Stepped.*(Low|Mid|High)/i', $profile, $m))
  $short_profile = 'Stepped - ' . $m[1];
elseif (preg_match('/Interpolated/i', $profile))
  $short_profile = 'Interpolated';
elseif (preg_match('/Manual override/i', $profile))
  $short_profile = 'Override Active';
elseif (preg_match('/Dell default/i', $profile))
  $short_profile = 'Dell Auto';

// Service status
$svc_running = false;
if (file_exists($pid_file)) {
  $pid = trim(file_get_contents($pid_file));
  $svc_running = $pid && file_exists("/proc/$pid");
}

// Stale data check — warn if last update > 3 minutes ago
$stale = false;
if ($timestamp !== '--') {
  $stale = (time() - strtotime($timestamp)) > 180;
}

$override_class = $override ? 'red-text' : 'green-text';
$override_label = $override ? 'Override ON - click to disable' : 'Enable Override (50%)';
$svc_class = $svc_running ? 'green-text' : 'red-text';
$svc_label = $svc_running ? '&#9679; Running' : '&#9679; Stopped';
$stale_warning = $stale ? '<br><span style="color:#e67e22;font-size:10px;">&#9888; Data may be stale</span>' : '';

$mytiles[$pluginname]['column1'] = <<<EOT
<tbody id="tblIdracFans" title="iDRAC Fans">
  <tr>
    <td>
      <i class="fa fa-tachometer f32"></i>
      <div class="section">
        iDRAC Fans<br>
        <span id="idrac-profile">{$short_profile}</span>
      </div>
    </td>
  </tr>
  <tr>
    <td>
      <span id="idrac-fan-pct">{$fan_display}</span> &mdash; <span id="idrac-fan-rpm">{$rpm_display}</span> RPM<br>
      CPU: <span id="idrac-cpu-temp">{$cpu_temp}</span>C<br>
      <a href="#" id="idrac-override-btn" class="{$override_class}" onclick="idracToggleOverride();return false;" style="font-size:11px;font-weight:600;text-decoration:none;">{$override_label}</a><br>
      <span class="{$svc_class}" style="font-size:11px;" id="idrac-svc-status">{$svc_label}</span>
      &nbsp;
      <a href="#" id="idrac-svc-btn" onclick="idracServiceToggle();return false;" style="font-size:11px;text-decoration:none;" class="orange-text"><?= $svc_running ? 'Stop' : 'Start' ?></a>
      &nbsp;|&nbsp;
      <a href="#" onclick="idracServiceAction('restart');return false;" style="font-size:11px;text-decoration:none;" class="orange-text">Restart</a><br>
      <span style="font-size:9px;color:#555;" id="idrac-time">{$timestamp}</span>{$stale_warning}
    </td>
  </tr>
</tbody>
EOT;

$control_url = '/plugins/idrac-fan-controller/control.php';
$status_json = '/mnt/user/appdata/idrac-fan-controller/status.json';
?>
<script>
function idracToggleOverride() {
  var btn = $('#idrac-override-btn');
  btn.text('Processing...').css('pointer-events','none').removeClass('red-text green-text').addClass('orange-text');
  var isActive = btn.data('active');
  $.post('<?=$control_url?>', { action: isActive ? 'disable_override' : 'enable_override', speed: 50 }, function() { setTimeout(idracRefresh, 1000); });
}

function idracServiceToggle() {
  var isRunning = $('#idrac-svc-status').hasClass('green-text');
  idracServiceAction(isRunning ? 'stop' : 'start');
}

function idracServiceAction(action) {
  $('#idrac-svc-btn').text('...').css('pointer-events','none');
  $.post('<?=$control_url?>', { action: action }, function(r) {
    idracRefresh();
    $('#idrac-svc-btn').css('pointer-events','auto');
  });
}

function idracRefresh() {
  $.getJSON('<?=$status_json?>?_=' + Date.now(), function(s) {
    var fanPct = (s.fan_speed_pct == 100) ? 'Dell Auto' : s.fan_speed_pct + '%';
    var rpm = s.avg_fan_rpm > 0 ? parseInt(s.avg_fan_rpm).toLocaleString() : '--';
    $('#idrac-fan-pct').text(fanPct);
    $('#idrac-fan-rpm').text(rpm);
    $('#idrac-cpu-temp').text(s.cpu1_temp);
    $('#idrac-time').text(s.timestamp);

    var profile = s.fan_profile || '';
    var short = profile;
    var m;
    if ((m = profile.match(/Stepped.*(Low|Mid|High)/i))) short = 'Stepped - ' + m[1];
    else if (/Interpolated/i.test(profile)) short = 'Interpolated';
    else if (/Manual override/i.test(profile)) short = 'Override Active';
    else if (/Dell default/i.test(profile)) short = 'Dell Auto';
    $('#idrac-profile').text(short);

    var btn = $('#idrac-override-btn');
    btn.css('pointer-events','auto');
    if (s.override_active) {
      btn.removeClass('green-text').addClass('red-text').text('Override ON - click to disable').data('active', true);
    } else {
      btn.removeClass('red-text').addClass('green-text').text('Enable Override (50%)').data('active', false);
    }

    // Check service status
    $.getJSON('<?=$control_url?>?action=status&_=' + Date.now(), function(r) {
      var svcBtn = $('#idrac-svc-btn');
      var svcStatus = $('#idrac-svc-status');
      if (r.status === 'running') {
        svcStatus.removeClass('red-text').addClass('green-text').html('&#9679; Running');
        svcBtn.text('Stop');
      } else {
        svcStatus.removeClass('green-text').addClass('red-text').html('&#9679; Stopped');
        svcBtn.text('Start');
      }
      svcBtn.css('pointer-events','auto');
    });
  });
}

$('#idrac-override-btn').data('active', <?= $override ? 'true' : 'false' ?>);
setInterval(idracRefresh, 30000);
</script>
