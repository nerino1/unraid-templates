Menu="Dashboard:99"
Icon="idrac-fan-controller.png"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.0-beta5', '>')"
---
<?php
require_once('/usr/local/emhttp/plugins/dynamix/include/Wrappers.php');

$status_file  = '/mnt/user/appdata/dell-idrac-fan-controller/logs/status.json';
$override_file = '/mnt/user/appdata/dell-idrac-fan-controller/logs/fan_override';

// Handle override toggle AJAX POST
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  header('Content-Type: application/json');
  $action = $_POST['action'] ?? '';
  if ($action === 'enable_override') {
    $speed = intval($_POST['speed'] ?? 50);
    file_put_contents($override_file, $speed);
    echo json_encode(['ok' => true, 'override_active' => true]);
  } elseif ($action === 'disable_override') {
    if (file_exists($override_file)) unlink($override_file);
    echo json_encode(['ok' => true, 'override_active' => false]);
  }
  exit;
}

// Read status JSON written by the container every CHECK_INTERVAL
$status = [];
if (file_exists($status_file)) {
  $status = json_decode(file_get_contents($status_file), true) ?? [];
}

$fan_pct    = $status['fan_speed_pct'] ?? null;
$fan_rpm    = $status['avg_fan_rpm']   ?? 0;
$cpu_temp   = $status['cpu1_temp']     ?? '--';
$inlet_temp = $status['inlet_temp']    ?? '--';
$profile    = $status['fan_profile']   ?? 'Unknown';
$timestamp  = $status['timestamp']     ?? '--';
$override   = $status['override_active'] ?? false;

$fan_display = ($fan_pct === null) ? '--' : (($fan_pct == 100) ? 'Dell' : $fan_pct . '%');
$rpm_display = ($fan_rpm > 0) ? number_format($fan_rpm) : '--';

// Shorten profile string for tile display
$short_profile = $profile;
if (preg_match('/Stepped.*(Low|Mid|High)/i', $profile, $m))
  $short_profile = 'Stepped · ' . $m[1];
elseif (preg_match('/Interpolated/i', $profile))
  $short_profile = 'Interpolated';
elseif (preg_match('/Manual override/i', $profile))
  $short_profile = 'Override Active';
elseif (preg_match('/Dell default/i', $profile))
  $short_profile = 'Dell Auto';
?>

<style>
#idrac-tile-wrap .idrac-row        { display:flex; align-items:baseline; margin-bottom:2px; }
#idrac-tile-wrap .idrac-label      { font-size:11px; color:#aaa; width:72px; flex-shrink:0; }
#idrac-tile-wrap .idrac-val        { font-size:13px; color:#ddd; font-weight:600; }
#idrac-tile-wrap .idrac-unit       { font-size:11px; color:#aaa; margin-left:2px; }
#idrac-tile-wrap .idrac-profile    { font-size:11px; color:#7ac; margin:4px 0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#idrac-tile-wrap .idrac-btn        { margin-top:6px; padding:3px 10px; border-radius:4px; border:none; cursor:pointer; font-size:11px; font-weight:600; width:100%; }
#idrac-tile-wrap .idrac-btn.active { background:#922; color:#fff; }
#idrac-tile-wrap .idrac-btn.idle   { background:#292; color:#fff; }
#idrac-tile-wrap .idrac-time       { font-size:9px; color:#555; margin-top:4px; }
</style>

<table cellspacing="0" cellpadding="0" class="dashboard box1">
  <thead sort="50">
    <tr class="hidden"><td></td><td colspan="3"></td><td></td></tr>
  </thead>
  <tbody class="sortable" sort="50">
    <tr>
      <td></td>
      <td class="next" colspan="3">
        <i class="fa fa-tachometer icon" style="font-size:32px;vertical-align:top;"></i>
        <div class="section">_(iDRAC Fans)_</div>
      </td>
      <td></td>
    </tr>
    <tr>
      <td></td>
      <td colspan="3">
        <div id="idrac-tile-wrap">
          <div class="idrac-row">
            <span class="idrac-label">_(Fan Speed)_</span>
            <span class="idrac-val" id="idrac-fan-pct"><?= htmlspecialchars($fan_display) ?></span>
          </div>
          <div class="idrac-row">
            <span class="idrac-label">_(Avg RPM)_</span>
            <span class="idrac-val" id="idrac-fan-rpm"><?= htmlspecialchars($rpm_display) ?></span>
            <span class="idrac-unit">RPM</span>
          </div>
          <div class="idrac-row">
            <span class="idrac-label">_(CPU Temp)_</span>
            <span class="idrac-val" id="idrac-cpu-temp"><?= htmlspecialchars($cpu_temp) ?></span>
            <span class="idrac-unit">°C</span>
          </div>
          <div class="idrac-row">
            <span class="idrac-label">_(Inlet Temp)_</span>
            <span class="idrac-val" id="idrac-inlet-temp"><?= htmlspecialchars($inlet_temp) ?></span>
            <span class="idrac-unit">°C</span>
          </div>
          <div class="idrac-profile" id="idrac-profile" title="<?= htmlspecialchars($profile) ?>">
            <?= htmlspecialchars($short_profile) ?>
          </div>
          <button class="idrac-btn <?= $override ? 'active' : 'idle' ?>" id="idrac-override-btn" onclick="idracToggleOverride()">
            <?= $override ? '🔴 _(Override On)_ — _(Click to disable)_' : '🟢 _(Enable Override)_ (50%)' ?>
          </button>
          <div class="idrac-time" id="idrac-time"><?= htmlspecialchars($timestamp) ?></div>
        </div>
      </td>
      <td></td>
    </tr>
  </tbody>
</table>

<script>
function idracToggleOverride() {
  var btn = document.getElementById('idrac-override-btn');
  var isActive = btn.classList.contains('active');
  $.post('/plugins/idrac-fan-controller/idrac-fan-controller.page',
    { action: isActive ? 'disable_override' : 'enable_override', speed: 50 },
    function(data) { idracRefresh(); }
  );
}

function idracRefresh() {
  $.getJSON('/mnt/user/appdata/dell-idrac-fan-controller/logs/status.json?_=' + Date.now(), function(s) {
    var fanPct = (s.fan_speed_pct == 100) ? 'Dell' : s.fan_speed_pct + '%';
    var rpm    = s.avg_fan_rpm > 0 ? s.avg_fan_rpm.toLocaleString() : '--';

    $('#idrac-fan-pct').text(fanPct);
    $('#idrac-fan-rpm').text(rpm);
    $('#idrac-cpu-temp').text(s.cpu1_temp);
    $('#idrac-inlet-temp').text(s.inlet_temp);
    $('#idrac-time').text(s.timestamp);

    var profile = s.fan_profile || '';
    var short = profile;
    var m;
    if ((m = profile.match(/Stepped.*(Low|Mid|High)/i))) short = 'Stepped · ' + m[1];
    else if (/Interpolated/i.test(profile)) short = 'Interpolated';
    else if (/Manual override/i.test(profile)) short = 'Override Active';
    else if (/Dell default/i.test(profile)) short = 'Dell Auto';
    $('#idrac-profile').text(short).attr('title', profile);

    var btn = $('#idrac-override-btn');
    if (s.override_active) {
      btn.removeClass('idle').addClass('active').text('🔴 Override On — Click to disable');
    } else {
      btn.removeClass('active').addClass('idle').text('🟢 Enable Override (50%)');
    }
  });
}

// Refresh every 30 seconds
setInterval(idracRefresh, 30000);
</script>
