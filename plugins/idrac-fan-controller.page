Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.11.9','>')"
Menu="Dashboard:0"
Icon="tachometer"
---
<?php
$pluginname = "iDRAC Fans";

$status_file   = '/mnt/user/appdata/dell-idrac-fan-controller/logs/status.json';
$override_file = '/mnt/user/appdata/dell-idrac-fan-controller/logs/fan_override';

// Handle override toggle AJAX POST
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  header('Content-Type: application/json');
  $action = $_POST['action'] ?? '';
  if ($action === 'enable_override') {
    $speed = intval($_POST['speed'] ?? 50);
    file_put_contents($override_file, $speed);
    echo json_encode(['ok' => true, 'override_active' => true]);
  } elseif ($action === 'disable_override') {
    if (file_exists($override_file)) unlink($override_file);
    echo json_encode(['ok' => true, 'override_active' => false]);
  }
  exit;
}

// Read status JSON written by the container every CHECK_INTERVAL
$status = [];
if (file_exists($status_file)) {
  $status = json_decode(file_get_contents($status_file), true) ?? [];
}

$fan_pct    = $status['fan_speed_pct'] ?? null;
$fan_rpm    = $status['avg_fan_rpm']   ?? 0;
$cpu_temp   = $status['cpu1_temp']     ?? '--';
$inlet_temp = $status['inlet_temp']    ?? '--';
$profile    = $status['fan_profile']   ?? 'No data';
$timestamp  = $status['timestamp']     ?? '--';
$override   = $status['override_active'] ?? false;

$fan_display = ($fan_pct === null) ? '--' : (($fan_pct == 100) ? 'Dell' : $fan_pct . '%');
$rpm_display = ($fan_rpm > 0) ? number_format($fan_rpm) : '--';

// Shorten profile string for tile display
$short_profile = $profile;
if (preg_match('/Stepped.*(Low|Mid|High)/i', $profile, $m))
  $short_profile = 'Stepped &middot; ' . $m[1];
elseif (preg_match('/Interpolated/i', $profile))
  $short_profile = 'Interpolated';
elseif (preg_match('/Manual override/i', $profile))
  $short_profile = 'Override Active';
elseif (preg_match('/Dell default/i', $profile))
  $short_profile = 'Dell Auto';

$override_btn_class = $override ? 'red-text' : 'green-text';
$override_btn_label = $override ? '&#9940; Override ON &mdash; click to disable' : '&#9989; Enable Override (50%)';

$mytiles[$pluginname]['column1'] = <<<EOT
<tbody id="tblIdracFans" title="_(iDRAC Fans)_">
  <tr>
    <td>
      <i class="fa fa-tachometer f32"></i>
      <div class="section">
        _(iDRAC Fans)_<br>
        <span id="idrac-profile" title="{$profile}">{$short_profile}</span>
      </div>
    </td>
  </tr>
  <tr>
    <td>
      <table style="width:100%;border:none;">
        <tr>
          <td style="padding:2px 8px 2px 0;color:#aaa;font-size:11px;">_(Fan Speed)_</td>
          <td style="font-size:15px;font-weight:600;" id="idrac-fan-pct">{$fan_display}</td>
        </tr>
        <tr>
          <td style="padding:2px 8px 2px 0;color:#aaa;font-size:11px;">_(Avg RPM)_</td>
          <td style="font-size:15px;font-weight:600;" id="idrac-fan-rpm">{$rpm_display} <span style="font-size:11px;color:#aaa;">RPM</span></td>
        </tr>
        <tr>
          <td style="padding:2px 8px 2px 0;color:#aaa;font-size:11px;">_(CPU Temp)_</td>
          <td style="font-size:15px;font-weight:600;" id="idrac-cpu-temp">{$cpu_temp} <span style="font-size:11px;color:#aaa;">°C</span></td>
        </tr>
        <tr>
          <td style="padding:2px 8px 2px 0;color:#aaa;font-size:11px;">_(Inlet Temp)_</td>
          <td style="font-size:15px;font-weight:600;" id="idrac-inlet-temp">{$inlet_temp} <span style="font-size:11px;color:#aaa;">°C</span></td>
        </tr>
        <tr>
          <td colspan="2" style="padding-top:6px;">
            <a href="#" class="{$override_btn_class}" id="idrac-override-btn" onclick="idracToggleOverride();return false;" style="font-size:11px;font-weight:600;">
              {$override_btn_label}
            </a>
          </td>
        </tr>
        <tr>
          <td colspan="2" style="font-size:9px;color:#555;padding-top:4px;" id="idrac-time">{$timestamp}</td>
        </tr>
      </table>
    </td>
  </tr>
</tbody>
EOT;
?>

<script>
function idracToggleOverride() {
  var btn = $('#idrac-override-btn');
  var isActive = btn.hasClass('red-text');
  $.post('/plugins/idrac-fan-controller/idrac-fan-controller.page',
    { action: isActive ? 'disable_override' : 'enable_override', speed: 50 },
    function() { idracRefresh(); }
  );
}

function idracRefresh() {
  $.getJSON('/mnt/user/appdata/dell-idrac-fan-controller/logs/status.json?_=' + Date.now(), function(s) {
    var fanPct = (s.fan_speed_pct == 100) ? 'Dell' : s.fan_speed_pct + '%';
    var rpm    = s.avg_fan_rpm > 0 ? parseInt(s.avg_fan_rpm).toLocaleString() : '--';

    $('#idrac-fan-pct').text(fanPct);
    $('#idrac-fan-rpm').html(rpm + ' <span style="font-size:11px;color:#aaa;">RPM</span>');
    $('#idrac-cpu-temp').html(s.cpu1_temp + ' <span style="font-size:11px;color:#aaa;">°C</span>');
    $('#idrac-inlet-temp').html(s.inlet_temp + ' <span style="font-size:11px;color:#aaa;">°C</span>');
    $('#idrac-time').text(s.timestamp);

    var profile = s.fan_profile || '';
    var short = profile;
    var m;
    if ((m = profile.match(/Stepped.*(Low|Mid|High)/i))) short = 'Stepped · ' + m[1];
    else if (/Interpolated/i.test(profile)) short = 'Interpolated';
    else if (/Manual override/i.test(profile)) short = 'Override Active';
    else if (/Dell default/i.test(profile)) short = 'Dell Auto';
    $('#idrac-profile').text(short).attr('title', profile);

    var btn = $('#idrac-override-btn');
    if (s.override_active) {
      btn.removeClass('green-text').addClass('red-text')
         .html('&#9940; Override ON &mdash; click to disable');
    } else {
      btn.removeClass('red-text').addClass('green-text')
         .html('&#9989; Enable Override (50%)');
    }
  });
}

setInterval(idracRefresh, 30000);
</script>
