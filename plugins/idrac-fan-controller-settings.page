<?php
$cfg_file = '/boot/config/plugins/idrac-fan-controller/idrac-fan-controller.cfg';
$rc_script = '/etc/rc.d/rc.idrac-fan-controller';

// Handle form save
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['save'])) {
  $fields = [
    'IDRAC_HOST', 'IDRAC_USERNAME', 'IDRAC_PASSWORD',
    'FAN_CONTROL_MODE', 'FAN_SPEED', 'CPU_TEMPERATURE_THRESHOLD', 'CHECK_INTERVAL',
    'STEPPED_MID_TEMP', 'STEPPED_MID_FAN_SPEED',
    'STEPPED_HIGH_TEMP', 'STEPPED_HIGH_FAN_SPEED',
    'INTERP_LOW_TEMP', 'INTERP_HIGH_TEMP', 'INTERP_HIGH_FAN_SPEED',
    'LOG_RETENTION_DAYS',
    'DISABLE_THIRD_PARTY_PCIE_CARD_DELL_DEFAULT_COOLING_RESPONSE',
    'KEEP_THIRD_PARTY_PCIE_CARD_COOLING_RESPONSE_STATE_ON_EXIT'
  ];

  $lines = ["# iDRAC Fan Controller Configuration\n# Saved by Settings UI - " . date('Y-m-d H:i:s') . "\n"];
  foreach ($fields as $f) {
    $val = $_POST[$f] ?? '';
    $val = preg_replace('/[^a-zA-Z0-9@._\-]/', '', $val); // sanitize
    // Password can have special chars - handle separately
    if ($f === 'IDRAC_PASSWORD') {
      $val = htmlspecialchars_decode($_POST[$f] ?? '');
      $val = str_replace('"', '\\"', $val);
    }
    $lines[] = "{$f}=\"{$val}\"";
  }

  file_put_contents($cfg_file, implode("\n", $lines) . "\n");

  // Restart service if requested
  if (isset($_POST['restart'])) {
    shell_exec("$rc_script restart > /dev/null 2>&1 &");
    $msg = "Settings saved and service restarting...";
  } else {
    $msg = "Settings saved. Restart the service to apply changes.";
  }
}

// Load current config
$cfg = [];
if (file_exists($cfg_file)) {
  $lines = file($cfg_file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
  foreach ($lines as $line) {
    if (substr(trim($line), 0, 1) === '#') continue;
    if (strpos($line, '=') !== false) {
      list($key, $val) = explode('=', $line, 2);
      $cfg[trim($key)] = trim($val, " \t\n\r\0\x0B\"'");
    }
  }
}

// Defaults
$c = function($key, $default='') use ($cfg) {
  return htmlspecialchars($cfg[$key] ?? $default);
};

$mode = $cfg['FAN_CONTROL_MODE'] ?? 'stepped';
?>

