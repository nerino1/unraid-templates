<script>
function updateMode(mode) {
  document.querySelectorAll('.idrac-mode-section').forEach(function(el) {
    el.classList.remove('active');
  });
  var section = document.getElementById('mode-' + mode);
  if (section) section.classList.add('active');
}

function svcAction(action) {
  var statusEl = document.getElementById('svc-status');
  statusEl.innerHTML = '<span style="color:#f6ad55">&#9679; ' + action.charAt(0).toUpperCase() + action.slice(1) + 'ing...</span>';
  $.post('/plugins/idrac-fan-controller/control.php', { action: action }, function(data) {
    setTimeout(checkStatus, 2000);
  });
}

function checkStatus() {
  fetch('/plugins/idrac-fan-controller/control.php?action=status')
    .then(function(r){ return r.json(); })
    .then(function(data) {
      var el = document.getElementById('svc-status');
      if (data.status === 'running') {
        el.innerHTML = '<span style="color:#68d391">&#9679; Running</span>';
      } else {
        el.innerHTML = '<span style="color:#fc8181">&#9679; Stopped</span>';
      }
    });
}

checkStatus();
setInterval(checkStatus, 10000);
</script>
