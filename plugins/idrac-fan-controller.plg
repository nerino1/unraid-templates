<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "idrac-fan-controller">
  <!ENTITY author      "nerino1">
  <!ENTITY version     "2026.05.19">
  <!ENTITY pluginURL   "https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller.plg">
  <!ENTITY pluginDir   "/usr/local/emhttp/plugins/&name;">
  <!ENTITY configDir   "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;">

<CHANGES>
###2026.05.19
- Initial release as native Unraid plugin
- Dashboard tile: fan speed, RPM, CPU temp, profile, service controls, override toggle
- Stats tab: historical graphs for temps, fan %, RPM (24h/7d/30d/1yr)
- Stepped and interpolation fan curve modes
- Backup override via flag file
- Watchdog cron to auto-restart if stopped
- Graceful Dell handback on shutdown/reboot
- Settings page under Settings menu
</CHANGES>

<!-- Create directories -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /usr/local/emhttp/plugins/idrac-fan-controller
mkdir -p /boot/config/plugins/idrac-fan-controller
mkdir -p /mnt/user/appdata/idrac-fan-controller
</INLINE>
</FILE>

<!-- Install plugin UI files -->
<FILE Name="/usr/local/emhttp/plugins/idrac-fan-controller/idrac-fan-controller.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller.page</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/idrac-fan-controller/fan-graphs.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/fan-graphs.page</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/idrac-fan-controller/idrac-fan-controller-settings.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller-settings.page</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/idrac-fan-controller/control.php">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/control.php</URL>
</FILE>

<!-- Install service scripts to flash drive -->
<FILE Name="/boot/config/plugins/idrac-fan-controller/idrac-fan-controller.sh">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller.sh</URL>
</FILE>

<FILE Name="/boot/config/plugins/idrac-fan-controller/rc.idrac-fan-controller">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/rc.idrac-fan-controller</URL>
</FILE>

<!-- Install UI files to flash drive for boot persistence -->
<FILE Run="/bin/bash">
<INLINE>
cp /usr/local/emhttp/plugins/idrac-fan-controller/idrac-fan-controller.page /boot/config/plugins/idrac-fan-controller/
cp /usr/local/emhttp/plugins/idrac-fan-controller/fan-graphs.page /boot/config/plugins/idrac-fan-controller/
cp /usr/local/emhttp/plugins/idrac-fan-controller/idrac-fan-controller-settings.page /boot/config/plugins/idrac-fan-controller/
cp /usr/local/emhttp/plugins/idrac-fan-controller/control.php /boot/config/plugins/idrac-fan-controller/
cp /boot/config/plugins/idrac-fan-controller/rc.idrac-fan-controller /etc/rc.d/rc.idrac-fan-controller
chmod +x /etc/rc.d/rc.idrac-fan-controller
chmod +x /boot/config/plugins/idrac-fan-controller/idrac-fan-controller.sh
</INLINE>
</FILE>

<!-- Install default config only if one does not already exist -->
<FILE Run="/bin/bash">
<INLINE>
if [ ! -f /boot/config/plugins/idrac-fan-controller/idrac-fan-controller.cfg ]; then
  wget -q -O /boot/config/plugins/idrac-fan-controller/idrac-fan-controller.cfg \
    https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller.cfg
fi
</INLINE>
</FILE>

<!-- Install shutdown hook script -->
<FILE Name="/boot/config/plugins/idrac-fan-controller/shutdown.sh">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/shutdown.sh</URL>
</FILE>

<!-- Register shutdown hook -->
<FILE Run="/bin/bash">
<INLINE>
chmod +x /boot/config/plugins/idrac-fan-controller/shutdown.sh
if ! grep -q "idrac-fan-controller" /etc/rc.d/rc.local.stop 2>/dev/null; then
  echo "" >> /etc/rc.d/rc.local.stop
  echo "# iDRAC Fan Controller - hand back to Dell on shutdown" >> /etc/rc.d/rc.local.stop
  echo "/boot/config/plugins/idrac-fan-controller/shutdown.sh" >> /etc/rc.d/rc.local.stop
fi
</INLINE>
</FILE>

<!-- Install watchdog cron -->
<FILE Run="/bin/bash">
<INLINE>
( crontab -l 2>/dev/null | grep -v "idrac-fan-controller"; echo "* * * * * [ -f /tmp/idrac-fan-controller.stopped ] || /etc/rc.d/rc.idrac-fan-controller status > /dev/null 2>&amp;1 || /etc/rc.d/rc.idrac-fan-controller start > /dev/null 2>&amp;1" ) | crontab -
</INLINE>
</FILE>

<!-- Add to go file for boot persistence -->
<FILE Run="/bin/bash">
<INLINE>
if ! grep -q "idrac-fan-controller" /boot/config/go; then
  echo "" >> /boot/config/go
  echo "# iDRAC Fan Controller plugin" >> /boot/config/go
  echo "mkdir -p /usr/local/emhttp/plugins/idrac-fan-controller" >> /boot/config/go
  echo "cp /boot/config/plugins/idrac-fan-controller/*.page /usr/local/emhttp/plugins/idrac-fan-controller/ 2>/dev/null" >> /boot/config/go
  echo "cp /boot/config/plugins/idrac-fan-controller/control.php /usr/local/emhttp/plugins/idrac-fan-controller/ 2>/dev/null" >> /boot/config/go
  echo "cp /boot/config/plugins/idrac-fan-controller/rc.idrac-fan-controller /etc/rc.d/ 2>/dev/null" >> /boot/config/go
  echo "chmod +x /etc/rc.d/rc.idrac-fan-controller" >> /boot/config/go
  echo "/etc/rc.d/rc.idrac-fan-controller start" >> /boot/config/go
fi
</INLINE>
</FILE>

<!-- Start the service -->
<FILE Run="/bin/bash">
<INLINE>
/etc/rc.d/rc.idrac-fan-controller start
echo ""
echo "iDRAC Fan Controller installed successfully."
echo "Go to Settings > iDRAC Fan Controller to configure."
echo ""
</INLINE>
</FILE>

</PLUGIN>
