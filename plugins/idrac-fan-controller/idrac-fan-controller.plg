<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name        "idrac-fan-controller">
  <!ENTITY author      "nerino1">
  <!ENTITY version     "2026.05.19">
  <!ENTITY pluginURL   "https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/idrac-fan-controller.plg">
  <!ENTITY pluginDir   "/usr/local/emhttp/plugins/&name;">
  <!ENTITY configDir   "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;">

<CHANGES>
###2026.05.19
- Initial release as native Unraid plugin
- Dashboard tile: fan speed, RPM, CPU temp, profile, service controls, override toggle
- Stats tab: historical graphs for temps, fan %, RPM (24h/7d/30d/1yr)
- Stepped and interpolation fan curve modes
- Backup override via flag file
- Watchdog cron to auto-restart if stopped
- Graceful Dell handback on shutdown/reboot
</CHANGES>

<!-- Create directories -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p &pluginDir;
mkdir -p &configDir;
mkdir -p /mnt/user/appdata/idrac-fan-controller
</INLINE>
</FILE>

<!-- Install plugin UI files -->
<FILE Name="&pluginDir;/idrac-fan-controller.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/idrac-fan-controller.page</URL>
</FILE>

<FILE Name="&pluginDir;/fan-graphs.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/fan-graphs.page</URL>
</FILE>

<FILE Name="&pluginDir;/idrac-fan-controller-settings.page">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/idrac-fan-controller-settings.page</URL>
</FILE>

<FILE Name="&pluginDir;/control.php">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/control.php</URL>
</FILE>

<!-- Install service scripts -->
<FILE Name="&configDir;/idrac-fan-controller.sh">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/idrac-fan-controller.sh</URL>
</FILE>

<FILE Name="/etc/rc.d/rc.idrac-fan-controller">
<URL>https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/rc.idrac-fan-controller</URL>
</FILE>

<!-- Install default config only if one doesn't already exist -->
<FILE Run="/bin/bash">
<INLINE>
if [ ! -f &configDir;/idrac-fan-controller.cfg ]; then
  wget -q -O &configDir;/idrac-fan-controller.cfg \
    https://raw.githubusercontent.com/nerino1/unraid-templates/main/plugins/idrac-fan-controller/idrac-fan-controller.cfg
fi
</INLINE>
</FILE>

<!-- Set permissions -->
<FILE Run="/bin/bash">
<INLINE>
chmod +x /etc/rc.d/rc.idrac-fan-controller
chmod +x &configDir;/idrac-fan-controller.sh
</INLINE>
</FILE>

<!-- Install shutdown hook -->
<FILE Run="/bin/bash">
<INLINE>
# Add shutdown hook if not already present
if ! grep -q "idrac-fan-controller" /etc/rc.d/rc.local.stop 2>/dev/null; then
  cat >> /etc/rc.d/rc.local.stop << 'EOF'

# iDRAC Fan Controller - hand back to Dell on shutdown
CFG="/boot/config/plugins/idrac-fan-controller/idrac-fan-controller.cfg"
if [ -f "$CFG" ]; then
  source "$CFG"
  LOGIN="lanplus -H $IDRAC_HOST -U $IDRAC_USERNAME -P $IDRAC_PASSWORD"
  [[ "$IDRAC_HOST" == "local" ]] && LOGIN="open"
  /usr/bin/ipmitool -I $LOGIN raw 0x30 0x30 0x01 0x01 > /dev/null 2>&1
fi
EOF
fi
</INLINE>
</FILE>

<!-- Install watchdog cron -->
<FILE Run="/bin/bash">
<INLINE>
# Add watchdog cron job - checks every minute if service is running
CRON_LINE="* * * * * /etc/rc.d/rc.idrac-fan-controller status > /dev/null 2>&1 || /etc/rc.d/rc.idrac-fan-controller start > /dev/null 2>&1"
( crontab -l 2>/dev/null | grep -v "idrac-fan-controller"; echo "$CRON_LINE" ) | crontab -
</INLINE>
</FILE>

<!-- Add to go file for boot persistence -->
<FILE Run="/bin/bash">
<INLINE>
if ! grep -q "idrac-fan-controller" /boot/config/go; then
  cat >> /boot/config/go << 'EOF'

# iDRAC Fan Controller plugin
mkdir -p /usr/local/emhttp/plugins/idrac-fan-controller
cp /boot/config/plugins/idrac-fan-controller/*.page /usr/local/emhttp/plugins/idrac-fan-controller/ 2>/dev/null
cp /boot/config/plugins/idrac-fan-controller/control.php /usr/local/emhttp/plugins/idrac-fan-controller/ 2>/dev/null
cp /boot/config/plugins/idrac-fan-controller/rc.idrac-fan-controller /etc/rc.d/ 2>/dev/null
chmod +x /etc/rc.d/rc.idrac-fan-controller
/etc/rc.d/rc.idrac-fan-controller start
EOF
fi
</INLINE>
</FILE>

<!-- Copy UI files to boot for persistence -->
<FILE Run="/bin/bash">
<INLINE>
cp &pluginDir;/idrac-fan-controller.page &configDir;/idrac-fan-controller.page 2>/dev/null
cp &pluginDir;/fan-graphs.page &configDir;/fan-graphs.page 2>/dev/null
cp &pluginDir;/idrac-fan-controller-settings.page &configDir;/idrac-fan-controller-settings.page 2>/dev/null
cp &pluginDir;/control.php &configDir;/control.php 2>/dev/null
cp /etc/rc.d/rc.idrac-fan-controller &configDir;/rc.idrac-fan-controller 2>/dev/null
</INLINE>
</FILE>

<!-- Start the service -->
<FILE Run="/bin/bash">
<INLINE>
/etc/rc.d/rc.idrac-fan-controller start
echo ""
echo "iDRAC Fan Controller plugin installed successfully."
echo "Edit your settings at: /boot/config/plugins/idrac-fan-controller/idrac-fan-controller.cfg"
echo "Then restart the service: /etc/rc.d/rc.idrac-fan-controller restart"
echo ""
</INLINE>
</FILE>

</PLUGIN>
