<?xml version="1.0"?>
<Container version="2">
  <Name>Dell-iDRAC-Fan-Controller</Name>
  <Repository>YOUR_DOCKERHUB_USERNAME/dell_idrac_fan_controller:latest</Repository>
  <Registry>https://hub.docker.com/r/YOUR_DOCKERHUB_USERNAME/dell_idrac_fan_controller</Registry>
  <Network>none</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/nerino1/Dell_iDRAC_fan_controller_Docker</Support>
  <Project>https://github.com/nerino1/Dell_iDRAC_fan_controller_Docker</Project>
  <Overview>Controls Dell PowerEdge fan speeds via iDRAC IPMI with stepped or interpolated fan curves.</Overview>
  <Category>Tools:</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/unraid-templates/main/dell_idrac_fan_controller.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/YOUR_GITHUB_USERNAME/unraid-templates/main/dell_idrac_fan_controller_icon.png</Icon>
  <ExtraParams/>
  <Description>Controls Dell PowerEdge fan speeds via iDRAC IPMI. Supports standard, stepped, and interpolated fan curve modes.</Description>
  <Networking>
    <Mode>none</Mode>
  </Networking>
  <Environment>
    <Variable>
      <Value>192.168.0.x</Value>
      <Name>IDRAC_HOST</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>root</Value>
      <Name>IDRAC_USERNAME</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>calvin</Value>
      <Name>IDRAC_PASSWORD</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>stepped</Value>
      <Name>FAN_CONTROL_MODE</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>60</Value>
      <Name>CHECK_INTERVAL</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>5</Value>
      <Name>FAN_SPEED</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>45</Value>
      <Name>STEPPED_MID_TEMP</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>12</Value>
      <Name>STEPPED_MID_FAN_SPEED</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>55</Value>
      <Name>STEPPED_HIGH_TEMP</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>20</Value>
      <Name>STEPPED_HIGH_FAN_SPEED</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>35</Value>
      <Name>INTERP_LOW_TEMP</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>55</Value>
      <Name>INTERP_HIGH_TEMP</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>30</Value>
      <Name>INTERP_HIGH_FAN_SPEED</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>70</Value>
      <Name>CPU_TEMPERATURE_THRESHOLD</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>false</Value>
      <Name>DISABLE_THIRD_PARTY_PCIE_CARD_DELL_DEFAULT_COOLING_RESPONSE</Name>
      <Mode/>
    </Variable>
    <Variable>
      <Value>false</Value>
      <Name>KEEP_THIRD_PARTY_PCIE_CARD_COOLING_RESPONSE_STATE_ON_EXIT</Name>
      <Mode/>
    </Variable>
  </Environment>
</Container>
